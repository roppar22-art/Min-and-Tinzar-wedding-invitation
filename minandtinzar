<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedding Invitation - Min & Tinzar</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #f7ede2; --secondary: #81b29a; --accent: #e07a5f; --text: #3d405b; --gold: #c4a77d; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', sans-serif; background-color: var(--primary); text-align: center; }

        /* Envelope Scene */
        #envelope-scene {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.9); display: flex;
            justify-content: center; align-items: center; z-index: 1000;
        }
        .envelope {
            width: 280px; height: 180px; background: var(--secondary);
            position: relative; cursor: pointer; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex; justify-content: center; align-items: center;
        }
        .wax-seal {
            width: 70px; height: 70px; background: var(--accent);
            border-radius: 50%; color: white; display: flex;
            justify-content: center; align-items: center; font-family: 'Playfair Display';
            font-size: 24px; font-weight: bold; border: 4px solid rgba(255,255,255,0.2);
        }

        /* Main Content */
        #main-content { display: none; opacity: 0; transition: opacity 1.5s ease; }
        .hero {
            height: 100vh; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('hero.jpg');
            background-size: cover; background-position: center;
            display: flex; flex-direction: column; justify-content: center; color: white;
        }
        .hero h1 { font-family: 'Playfair Display'; font-size: 3.5rem; margin-bottom: 10px; }

        .countdown-section { padding: 80px 20px; background: white; border-radius: 30px 30px 0 0; margin-top: -30px; }
        .countdown { display: flex; justify-content: center; gap: 10px; margin-top: 30px; }
        .time-box { background: var(--secondary); color: white; padding: 15px; border-radius: 12px; min-width: 75px; }
        .time-box span { display: block; font-size: 1.8rem; font-weight: bold; }

        .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 20px; background: #fff; }
        .gallery img { width: 100%; height: 200px; object-fit: cover; border-radius: 10px; background: #eee; }

        .rsvp-section { padding: 80px 20px; background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('rsvp_bg.jpg'); background-size: cover; color: white; }
        .rsvp-form input, .rsvp-form select { width: 100%; max-width: 400px; padding: 15px; margin: 10px 0; border-radius: 8px; border: none; }
        .rsvp-form button { background: var(--accent); color: white; padding: 15px 40px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; max-width: 400px; }
    </style>
</head>
<body>

    <div id="envelope-scene" onclick="openEnvelope()">
        <div class="envelope">
            <div class="wax-seal">M&T</div>
            <p style="position:absolute; bottom:20px; color:#fff; font-style:italic;">Open Invitation</p>
        </div>
    </div>

    <div id="main-content">
        <section class="hero">
            <p style="letter-spacing: 3px;">THE WEDDING OF</p>
            <h1>Min & Tinzar</h1>
            <p>22.11.2026</p>
        </section>

        <section class="countdown-section">
            <h2 style="font-family: 'Playfair Display';">Countdown to Forever</h2>
            <div class="countdown">
                <div class="time-box"><span id="days">00</span>Days</div>
                <div class="time-box"><span id="hours">00</span>Hrs</div>
                <div class="time-box"><span id="minutes">00</span>Mins</div>
                <div class="time-box"><span id="seconds">00</span>Secs</div>
            </div>
        </section>

        <section class="gallery">
            <img src="gallery1.jpg" alt="Memory 1">
            <img src="gallery2.jpg" alt="Memory 2">
            <img src="gallery3.jpg" alt="Memory 3">
            <img src="gallery4.jpg" alt="Memory 4">
        </section>

        <section class="rsvp-section">
            <h2 style="font-family: 'Playfair Display'; margin-bottom: 20px;">Join Our Celebration</h2>
            <div class="rsvp-form">
                <form action="#">
                    <input type="text" placeholder="Your Full Name" required>
                    <select required>
                        <option value="" disabled selected>Number of Guests</option>
                        <option value="1">1 Person</option>
                        <option value="2">2 People</option>
                    </select>
                    <button type="submit">SUBMIT RSVP</button>
                </form>
            </div>
        </section>
    </div>

    <script>
        function openEnvelope() {
            document.getElementById('envelope-scene').style.opacity = '0';
            setTimeout(() => {
                document.getElementById('envelope-scene').style.display = 'none';
                document.getElementById('main-content').style.display = 'block';
                setTimeout(() => { document.getElementById('main-content').style.opacity = '1'; }, 100);
            }, 1000);
        }

        const targetDate = new Date('Nov 22, 2026 09:00:00').getTime();
        setInterval(() => {
            const now = new Date().getTime();
            const diff = targetDate - now;
            document.getElementById('days').innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
            document.getElementById('hours').innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById('minutes').innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById('seconds').innerText = Math.floor((diff % (1000 * 60)) / 1000);
        }, 1000);
    </script>
</body>
</html>

